{
  "private": true,
  "name": "personal-technical-learning-project",
  "version": "1.1.1",
  "license": "MIT",
  "description": "Global corporate governance and integration pipeline layer for polyglot monorepo",
  "homepage": "https://github.com/thiagosaud/personal-technical-learning-project",
  "keywords": [
    "ai-engineering",
    "data-engineering",
    "software-engineering",
    "machine-learning",
    "mlops",
    "artificial-intelligence",
    "devops",
    "ci-cd",
    "github-actions",
    "monorepo",
    "python",
    "typescript",
    "nodejs",
    "pnpm",
    "docker",
    "observability"
  ],
  "author": {
    "name": "THIAGO SAUD",
    "url": "https://github.com/thiagosaud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagosaud/personal-technical-learning-project.git"
  },
  "bugs": {
    "url": "https://github.com/thiagosaud/personal-technical-learning-project/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.22.0"
  },
  "validate-branch-name": {
    "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|release)/([a-z0-9.-]+)$",
    "errorMsg": "❌ [BRANCH LINT ERROR] Branch name outside the Enterprise standard!\n💡 Use the format: <type>/<short-description-in-kebab-case>\n📌 Example: feat/linear-regression-byd\n🚀 Allowed types: feat, fix, docs, style, refactor, perf, test, chore, ci, revert, release"
  },
  "scripts": {
    "prepare": "lefthook install",
    "infra:install:global:workspace:dependencies": "pnpm i --frozen-lockfile",
    "infra:install:global:python:dependencies": "uv sync --frozen --all-packages",
    "infra:script:setup": "bash ./scripts/setup.sh",
    "infra:script:lint:check:branchname": "bash ./scripts/validate-branch-name.sh",
    "infra:script:lint:check:commitmsg": "bash ./scripts/validate-commit-message.sh",
    "infra:release:changeset": "changeset",
    "infra:release:changeset:status": "changeset status --verbose",
    "infra:release:changeset:auto": "pnpm infra:release:changeset --since main",
    "infra:release:changeset:pre-enter": "pnpm infra:release:changeset pre enter rc",
    "infra:realease:changeset:pre-exit": "pnpm infra:release:changeset pre exit",
    "infra:release:changeset:version:packages": "pnpm infra:release:changeset version",
    "infra:release:changeset:publish:packages": "pnpm build && changeset publish",
    "infra:test:workflow:ci": "act pull_request -W .github/workflows/ci.yml",
    "infra:test:workflow:security-schedule": "act schedule -W .github/workflows/security-schedule.yml",
    "format:files": "prettier --write .",
    "format:code:py": "uv run --frozen ruff format .",
    "format:all": "pnpm format:files && pnpm format:code:py",
    "test:sast:secrets": "gitleaks-secret-scanner git --config=.gitleaks.toml --redact --verbose --exit-code=1",
    "test:sast:semgrep": "uv run --frozen semgrep scan --config=.semgrep.yaml --config=p/security-audit --quiet --error",
    "test:sast:py": "uv run bandit -r . -c .bandit.yaml",
    "test:unit:py": "uv run --frozen --all-packages pytest",
    "test:sast:all": "pnpm test:sast:secrets && pnpm test:sast:semgrep && pnpm test:sast:py",
    "test:unit:all": "pnpm test:unit:py",
    "eslint:check": "eslint . --max-warnings 0",
    "eslint:fix": "eslint . --fix",
    "lint:check:branchname": "validate-branch-name -t \"${BRANCH_NAME}\"",
    "lint:check:commit": "pnpm infra:script:lint:check:commitmsg",
    "lint:check:markdown": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot .",
    "lint:check:code:js": "prettier --check .",
    "lint:check:code:py": "uv run ruff check .",
    "lint:fix:markdown": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot . --fix",
    "lint:fix:code:py": "uv run --frozen ruff check . --fix",
    "lint:check:all": "pnpm lint:check:branchname && pnpm eslint:check && pnpm lint:check:commit && pnpm lint:check:markdown && pnpm lint:check:code:js && pnpm lint:check:code:py",
    "lint:fix:all": "pnpm lint:fix:markdown && pnpm lint:fix:code:py && pnpm eslint:fix && pnpm format:all"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks-secret-scanner": "^2.1.1",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "validate-branch-name": "^1.3.2"
  }
}
