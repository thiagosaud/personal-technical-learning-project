# EditorConfig Core Invariant Rules
# Official Reference: https://editorconfig.org

# Top-most EditorConfig file - stops further parent directory lookups
root = true

# ==========================================
# 1. GLOBAL INVARIANT SYSTEM BASELINE
# ==========================================
[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

# ==========================================
# 2. JAVASCRIPT / TYPESCRIPT / WEB ECOSYSTEM
# ==========================================
# Strict brace expansion matching for modern frontend governance tools
[*.{js,mjs,cjs,ts,tsx,jsx,json}]
indent_style = tab
indent_size = 2

# ==========================================
# 3. DEPLOYMENT & DEVOPS INFRASTRUCTURE
# ==========================================
[*.{yaml,yml}]
indent_style = tab
indent_size = 2

# Linux/macOS automation engines require hard tabs to execute properly
[Makefile]
indent_style = tab

# ==========================================
# 4. DOCUMENTATION LAYER OVERRIDES
# ==========================================
[*.md]
# Markdown requires trailing whitespaces to natively interpret line breaks (<br>)
trim_trailing_whitespace = false
indent_style = tab
indent_size = 2
