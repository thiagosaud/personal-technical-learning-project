{
  "private": true,
  "name": "personal-technical-learning-project",
  "version": "1.1.1",
  "license": "MIT",
  "description": "Global corporate governance and integration pipeline layer for polyglot monorepo",
  "homepage": "https://github.com/thiagosaud/personal-technical-learning-project",
  "keywords": [],
  "author": {
    "name": "THIAGO SAUD",
    "url": "https://github.com/thiagosaud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagosaud/personal-technical-learning-project.git"
  },
  "bugs": {
    "url": "https://github.com/thiagosaud/personal-technical-learning-project/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.22.0"
  },
  "validate-branch-name": {
    "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert|release)/([a-z0-9.-]+)$",
    "errorMsg": "❌ [BRANCH LINT ERROR] Branch name outside the Enterprise standard!\n💡 Use the format: <type>/<short-description-in-kebab-case>\n📌 Example: feat/linear-regression-byd\n🚀 Allowed types: feat, fix, docs, style, refactor, perf, test, chore, ci, revert, release"
  },
  "scripts": {
    "prepare": "lefthook install",
    "script:setup": "bash ./scripts/setup.sh",
    "script:release:github": "bash ./scripts/create-github-release.sh",
    "script:lint:branch:ci": "bash ./scripts/validate-branch-name.sh",
    "changeset": "changeset",
    "changeset:auto": "changeset --since main",
    "changeset:pre-enter": "changeset pre enter rc",
    "changeset:pre-exit": "changeset pre exit",
    "changeset:version:packages": "changeset version && pnpm install --no-frozen-lockfile",
    "security:secrets": "gitleaks detect --verbose --redact",
    "test:ci:local:all": "act pull_request --container-architecture linux/amd64 --rebuild",
    "test:py": "uv run --frozen --all-packages pytest",
    "format:js": "prettier --write .",
    "format:py": "uv run --frozen ruff format .",
    "eslint": "eslint . --max-warnings 0",
    "eslint:fix": "eslint . --fix",
    "lint:commit": "commitlint --edit",
    "lint:branch": "validate-branch-name",
    "lint:markdown": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot .",
    "lint:markdown:fix": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot . --fix",
    "lint:code:js": "prettier --check .",
    "lint:code:py": "uv run ruff check .",
    "lint:code:py:fix": "uv run --frozen ruff check . --fix",
    "lint:security:py": "uv run bandit -r . -c .bandit.yaml",
    "lint:security:semgrep": "uv run --frozen semgrep scan --config=.semgrep.yaml --config=p/security-audit --quiet --error",
    "lint:all:check": "pnpm lint:commit && pnpm lint:branch && pnpm lint:markdown && pnpm lint:code:js && pnpm lint:code:py && pnpm lint:security:py && pnpm lint:security:semgrep && pnpm eslint && pnpm security:secrets",
    "lint:all:fix": "pnpm lint:markdown:fix && pnpm lint:code:py:fix && pnpm eslint:fix && pnpm format:js && pnpm format:py"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "gitleaks-secret-scanner": "^2.1.1",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "validate-branch-name": "^1.3.2"
  }
}
