# EditorConfig Core Invariant Rules
# Reference: https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yaml,yml,js,ts,jsx,tsx,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
