# Global Enterprise Performance and Security Settings
# Official Reference: https://pnpm.io

# 1. HARDEN DEPENDENCY MANAGEMENT AND SUPPLY CHAIN ATTACK MITIGATION
# Explicitly grants permission for trusted binary tools to compile lifecycle scripts
only-built-dependencies[]=@changesets/cli
only-built-dependencies[]=gitleaks-secret-scanner
only-built-dependencies[]=lefthook

# Enforces strict package manager locks to prevent floating variations between environments
frozen-lockfile=true

# 2. CACHING AND NETWORK SPEED OPTIMIZATION
verify-store-integrity=true
